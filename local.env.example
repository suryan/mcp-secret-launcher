# Copy to local.env and adjust. Do not commit local.env if it contains secrets.

# Install / source (used by scripts/install.sh)
# MCP_SECRET_LAUNCHER_PREFIX=$HOME/.local
# MCP_SECRET_LAUNCHER_REF=main
# MCP_SECRET_LAUNCHER_REPO=https://github.com/suryan/mcp-secret-launcher.git
# MCP_SECRET_LAUNCHER_DIR=$HOME/.local/src/mcp-secret-launcher
# MCP_SECRET_LAUNCHER_BIN=$HOME/.local/bin/mcp-secret-launcher

# Quality gate
# MCP_SECRET_LAUNCHER_MIN_COVERAGE=95

# Tooling
# RUST_LOG=info
